# Public application endpoints
API_DOMAIN=api.multica.example.com
APP_DOMAIN=multica.example.com
COOKIE_DOMAIN=.example.com
CORS_ALLOWED_ORIGINS=https://multica.example.com
FRONTEND_HOST=web
FRONTEND_ORIGIN=https://multica.example.com
MULTICA_APP_URL=https://multica.example.com
MULTICA_PUBLIC_URL=https://multica.example.com
NEXT_PUBLIC_API_URL=https://api.multica.example.com
NEXT_PUBLIC_WS_URL=wss://api.multica.example.com
REMOTE_API_URL=http://backend:8080
BACKEND_HOST=backend
LOCAL_UPLOAD_BASE_URL=/app/data/uploads

# Application behavior
ALLOW_SIGNUP=false
APP_ENV=production
ATTACHMENT_DOWNLOAD_MODE=proxy

# PostgreSQL
POSTGRES_DB=multica
POSTGRES_HOST=postgres
POSTGRES_USER=multica
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://multica:replace-with-a-strong-password@postgres:5432/multica

# Redis
REDIS_PASSWORD=replace-with-a-strong-password
REDIS_URL=redis://:replace-with-a-strong-password@redis:6379/0

# Application secrets
JWT_SECRET=replace-with-a-long-random-value
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# S3-compatible object storage
AWS_ACCESS_KEY_ID=replace-with-an-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-a-secret-access-key
AWS_ENDPOINT_URL=https://s3.example.com
S3_BUCKET=multica
S3_REGION=auto
CLOUDFRONT_DOMAIN=

# Optional integrations
GOOGLE_REDIRECT_URI=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
